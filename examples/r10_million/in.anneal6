units metal
boundary p p p
atom_style atomic
atom_modify map array sort 0 0.0
read_data r10_rep6.data
include /home/drabold/lammps-runs/rosset_external/pot_kk.in
neighbor 1.0 bin
neigh_modify every 5 delay 0 check yes
timestep 0.001
velocity all create 500.0 20261105 mom yes rot no dist gaussian
fix nvt all nvt temp 500.0 500.0 0.1
thermo 100
thermo_style custom step temp pe press
run 500
unfix nvt
write_data r10_rep6_annealed.data nocoeff
thermo_style custom step pe fnorm fmax
min_style cg
minimize 0.0 1e-5 20000 100000
write_data r10_rep6_quenched.data nocoeff
